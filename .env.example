# Copy this file to .env and fill in LLM_API_KEY. Blank values fall back to the defaults.

# OpenAI-compatible endpoint (default: OpenRouter)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5

# Optional: pretend "today" is this date (the sample data ends in March 2026)
# EMPORIO_TODAY=2026-03-25

# Optional: override where the CSVs / PDF and the SQLite file live
# EMPORIO_DATA_DIR=
# EMPORIO_DB_PATH=

# Optional: embeddings for the manual search (hybrid with BM25). Needs LLM_API_KEY.
# Set EMPORIO_EMBEDDINGS=off to use BM25 only.
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMPORIO_EMBEDDINGS=off
