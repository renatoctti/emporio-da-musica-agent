# Copy this file to .env and fill in LLM_API_KEY. Blank values fall back to the defaults.

# OpenAI-compatible endpoint (default: OpenRouter)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5

# Optional: pretend "today" is this date (the sample data ends in March 2026)
# EMPORIO_TODAY=2026-03-25

# Optional: override where the CSVs / PDF and the SQLite file live
# EMPORIO_DATA_DIR=
# EMPORIO_DB_PATH=

# Optional: embeddings for the manual search (hybrid with BM25). Needs LLM_API_KEY.
# Set EMPORIO_EMBEDDINGS=off to use BM25 only.
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMPORIO_EMBEDDINGS=off

# Optional: model prices in USD per million tokens, to estimate the cost in emporio stats.
# The project does not know them; leave blank and the cost is shown as not configured.
# LLM_PRICE_IN_PER_M=
# LLM_PRICE_OUT_PER_M=

# Optional: tell the store team's tool (n8n, Slack incoming webhook, any HTTP endpoint)
# each time a new handoff ticket is opened. Blank means off.
# HANDOFF_WEBHOOK_URL=
